# Firebase クライアント設定 (Staging)
NEXT_PUBLIC_FIREBASE_API_KEY=your_staging_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=my-firebase-project-staging.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=my-firebase-project-staging
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=my-firebase-project-staging.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_staging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_staging_app_id_here

# Firebase Admin SDK
FIREBASE_PROJECT_ID=my-firebase-project-staging
FIREBASE_CLIENT_EMAIL=your-service-account@my-firebase-project-staging.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
